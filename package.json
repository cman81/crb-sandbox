{
  "name": "crb-sandbox-client",
  "version": "1.0.0",
  "description": "Competitive Ruleset Battle Sandbox Client Terminal",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "chromebook": "electron . --disable-gpu --disable-gpu-compositing",
    "build": "electron-builder --win",
    "dev": "cross-env NODE_ENV=development electron .",
    "devcb": "cross-env NODE_ENV=development electron . --disable-gpu --disable-gpu-compositing"
  },
  "keywords": [
    "game",
    "sandbox"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "cross-env": "^10.1.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.crb.sandboxclient.game",
    "productName": "CRB Sandbox Client",
    "files": [
      "*.js",
      "index.html",
      "vendor/**",
      "assets/**"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "build/icon.ico"
    }
  }
}
